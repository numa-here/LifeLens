# OpenAI API Key (Required for document analysis)
OPENAI_API_KEY=your_openai_api_key_here

# Vercel Postgres Database URL (Automatically set by Vercel when you add Postgres)
POSTGRES_URL=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NON_POOLING=

# Note: Vercel Blob storage is optional for MVP. The scanner currently uses base64 encoding.
# If you want to add file storage later, add:
# BLOB_READ_WRITE_TOKEN=
